# ==============================================================================
# PROOFPATH — ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# Copy this file to '.env' in local development or production.
# ==============================================================================

# Application & API
PROJECT_NAME=ProofPath
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Session Authentication
# Generate a cryptographically secure random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=your_cryptographically_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Persistence
# Local SQLite file by default. Can be switched to PostgreSQL e.g. postgresql://user:pass@localhost:5432/proofpath
DATABASE_URL=sqlite:///./proofpath.db

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Provider Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If left blank, ProofPath automatically operates with its deterministic rule-based evidence engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration & Watcher
# Optional personal access token to prevent rate-limiting on public repositories (recommended for development)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Webhook secret if using GitHub push webhooks
GITHUB_WEBHOOK_SECRET=
# Automatic background commit polling watcher
WATCHER_ENABLED=true
WATCHER_POLL_INTERVAL_SECONDS=30

# SSRF Protection & Network Limits
SSRF_TIMEOUT_SECONDS=10
SSRF_MAX_RESPONSE_BYTES=2097152

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Frontend Vite API Proxy / Target
VITE_API_URL=http://localhost:8000/api/v1

