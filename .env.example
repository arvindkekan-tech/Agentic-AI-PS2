# ==============================================================================
# PROOFPATH — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Copy this file to '.env' before running ProofPath.
# ==============================================================================

# Application & API
PROJECT_NAME=ProofPath
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Session Authentication
# In production, generate a secure random secret: openssl rand -hex 32
SECRET_KEY=proofpath_development_secret_key_replace_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Supabase Auth Integration
# If using Supabase Auth JWT tokens alongside native auth, provide the Supabase JWT secret from Project Settings -> API:
SUPABASE_JWT_SECRET=

# Database Persistence (PostgreSQL & Supabase)
# Local PostgreSQL Docker container:
DATABASE_URL=postgresql://proofpath:proofpath_dev_pass_2026@localhost:5432/proofpath
# Supabase PostgreSQL Transaction Pooler connection example:
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# File Upload Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Provider Configuration (Google Gemini)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If left blank, ProofPath automatically operates with its deterministic rule-based evidence engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration (Optional token for higher rate limits on public repositories)
GITHUB_TOKEN=

# SSRF Protection & Network Limits
SSRF_TIMEOUT_SECONDS=10
SSRF_MAX_RESPONSE_BYTES=2097152

# CORS (Frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
